<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_aura" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.aura</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Aura Navbar" name="aura_navbar_setting_container">
                    <setting string="Navbar Color" help="Main color of the sidebar navigation.">
                        <field name="aura_navbar_color" widget="color"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>